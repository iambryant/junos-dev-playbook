---
management_ip: "192.168.1.10/24"

junos_reboot_required:
  - "set system memory hugepages page-size 1024 page-count 10"

junos_config_host:
  groups:
    NFX-SXE-DEFAULT:
      interfaces:
        '"<sxe-*>"':
          description: '"Test description"'
          mtu: 9192
          ether-options:
            no-flow-control: true

  interfaces:
    apply-groups: "NFX-SXE-DEFAULT"
    sxe-0/0/0:
      "unit 0":
        family:
          ethernet-switching:
            interface-mode: "trunk"
    sxe-0/0/1:
      "unit 0":
        family:
          ethernet-switching:
            interface-mode: "trunk"

  # VLANs only need to be defined in the vlans stanza in NFX if they're being bridged to front panel ports via
  # sxe-* interfaces

vnf_instances:
  - name: "ubuntu-01"
    domain: "local"
    vcpu_count: 2
    memory: 8388608
    vcpu_mapping:
      - virtual_cpu: 0
        physical_cpu: 2
      - virtual_cpu: 1
        physical_cpu: 8
    hardware_virtualization: true
    hugepage: true
    no_default_interfaces: true
    interfaces:
      - name: "eth0"
        usage: "vlan"
        mode: "access"
        vlan_name: "default"
    no_autostart: true

    user_data:
      chpasswd:
        expire: False
      users:
        - name: admin
          gecos: Management user
          shell: /bin/bash
          ssh_authorized_keys:
            - <ssh_key_here>
          sudo: "ALL=(ALL) NOPASSWD:ALL"
      package_upgrade: true

    network_config:
      version: 1
      config:
        - type: physical
          name: ens3
          subnets:
            - type: dhcp
