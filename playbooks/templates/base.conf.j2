system {
    {% if name_servers is defined and name_servers %}
    replace:
    name-server {
        {% for server in name_servers %}
        {{ server }} routing-instance mgmt_junos;
        {% endfor %}
    }
    {% endif %}
    replace: 
    syslog {
        archive {
            size 100k;
            files 3;
        }
        user * {
            any emergency;
        }
        file interactive-commands {
            interactive-commands any;
        }
        file messages {
            any notice;
            authorization info;
        }
    }
    {% if ntp_servers is defined and ntp_servers %}
    replace:
    ntp {
        {% for server in ntp_servers %}
        server {{ server }} routing-instance mgmt_junos;
        {% endfor %}
    }
    {% endif %}
}
interfaces {
    lo0 {
        unit 0 {
            family inet {
                address 127.0.0.1/32;
            }
        }
    }
}
